# ─── Frontend (Vite) ──────────────────────────────────────────────
# These are pre-populated by Bolt and should NOT be changed.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Backend Edge Functions (Supabase secrets) ────────────────────
# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# Do not put service-role keys, Meta tokens, or app secrets in VITE_ variables.

# ─── WhatsApp contact form (added) ────────────────────────────────
# Frontend (Vite, build-time, public). Selects the ONE active workflow:
#   click-to-chat (default if unset) → opens wa.me; visitor presses Send in WhatsApp
#   api                              → Edge Function sends via WhatsApp Cloud API
# Only set "api" after the secrets below are configured and a test send worked.
VITE_CONTACT_DELIVERY_MODE=click-to-chat

# Supabase Edge Function secrets for `whatsapp-contact` (NEVER put these in a
# VITE_ variable or commit real values). Set with `supabase secrets set`.
# WHATSAPP_ACCESS_TOKEN=            # system-user token from Meta (secret)
# WHATSAPP_PHONE_NUMBER_ID=         # ID of the BUSINESS sender number (not your personal number)
# WHATSAPP_RECIPIENT=250798978475   # your personal WhatsApp, international format, digits only
# WHATSAPP_TEMPLATE_NAME=           # name of your APPROVED template (3 body variables)
# WHATSAPP_TEMPLATE_LANGUAGE=en     # language code the template was approved in
# ALLOWED_ORIGINS=https://your-portfolio-domain.com,http://localhost:5173
# GRAPH_API_VERSION=v26.0           # optional; defaults to v26.0
# RATE_LIMIT_SALT=                  # optional; random string used when hashing visitor IPs
# WHATSAPP_TIMEOUT_MS=10000         # optional

# Only for the optional `whatsapp-webhook` delivery receipts:
# WHATSAPP_APP_SECRET=              # Meta app secret (secret)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # any random string you also enter in Meta's webhook form
